class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int i,n,j,sum=0;
        n=nums.size();
        for(i=0;i<n;i++){
            for(j=i+1;j<n;j++){
                sum=nums[i]+nums[j];
                if(sum==target){
                    return{i,j};
                }
            }
        }
        return{};
    }
};
